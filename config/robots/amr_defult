# Default AMR Kinematic & Safety Parameters
robot_type: "differential_drive"
dimensions:
  length: 0.65 # meters
  width: 0.45  # meters
  height: 0.30 # meters
  collision_radius: 0.35 # meters

kinematics:
  max_linear_velocity: 1.0   # m/s
  max_linear_accel: 1.0      # m/s^2
  max_angular_velocity: 1.5  # rad/s
  max_angular_accel: 2.0     # rad/s^2

safety:
  emergency_stop_distance: 0.25 # meters
  warning_slowdown_distance: 0.60 # meters
  time_to_collision_threshold: 1.2 # seconds

