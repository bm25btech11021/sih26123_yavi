<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_fleet_description</name>
  <version>0.1.0</version>
  <description>Robot URDF/Xacro models, meshes, and kinematics description for YAVI-SIH26123 AMR Fleet.</description>
  <maintainer email="raghavgangrade72009@gmail.com">Raghav Gangrade</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>urdf</depend>
  <depend>xacro</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

