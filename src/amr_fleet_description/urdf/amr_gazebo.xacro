<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="amr_gazebo" params="
    robot_name
    prefix
    wheel_separation:=0.45
    wheel_radius:=0.10
  ">

    <!-- Differential Drive Plugin for Gazebo Harmonic -->
    <gazebo>
      <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <left_joint>${prefix}left_wheel_joint</left_joint>
        <right_joint>${prefix}right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>/${robot_name}/cmd_vel</topic>
        <odom_topic>/${robot_name}/odom_wheel</odom_topic>
        <tf_topic>/${robot_name}/tf_wheel</tf_topic>
        <frame_id>${prefix}odom</frame_id>
        <child_frame_id>${prefix}base_footprint</child_frame_id>
        <max_linear_acceleration>2.0</max_linear_acceleration>
        <min_linear_acceleration>-2.0</min_linear_acceleration>
        <max_angular_acceleration>3.0</max_angular_acceleration>
        <min_angular_acceleration>-3.0</min_angular_acceleration>
      </plugin>

      <!-- Ground-Truth Odometry and TF Publisher in map frame -->
      <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
        <odom_frame>map</odom_frame>
        <robot_base_frame>${prefix}base_footprint</robot_base_frame>
        <odom_topic>/${robot_name}/odom</odom_topic>
        <tf_topic>/${robot_name}/tf</tf_topic>
        <dimensions>2</dimensions>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>

      <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <topic>/${robot_name}/joint_states</topic>
        <joint_name>${prefix}left_wheel_joint</joint_name>
        <joint_name>${prefix}right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

    <!-- 2D LiDAR Sensor Configuration -->
    <gazebo reference="${prefix}laser_frame">
      <sensor name="${robot_name}_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>/${robot_name}/scan</topic>
        <gz_frame_id>${prefix}laser_frame</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <!-- Surface properties for high-traction drive wheels -->
    <gazebo reference="${prefix}left_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>10000000.0</kp>
      <kd>1.0</kd>
    </gazebo>

    <gazebo reference="${prefix}right_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>10000000.0</kp>
      <kd>1.0</kd>
    </gazebo>

    <!-- Surface properties for low-friction casters -->
    <gazebo reference="${prefix}front_caster">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
    </gazebo>

    <gazebo reference="${prefix}rear_caster">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
    </gazebo>

  </xacro:macro>

</robot>
