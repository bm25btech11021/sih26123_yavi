<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="amr_lidar" params="
    prefix
    laser_x:=0.22
    laser_y:=0.0
    laser_z:=0.18
  ">

    <joint name="${prefix}laser_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}laser_frame"/>
      <origin xyz="${laser_x} ${laser_y} ${laser_z}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}laser_frame">
      <!-- 1. Lower Turret Mount Base -->
      <visual name="lidar_mount">
        <origin xyz="0 0 0.010" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.048" length="0.020"/>
        </geometry>
        <material name="amr_chassis_dark"/>
      </visual>

      <!-- 2. Rotating Sensor Turret Body -->
      <visual name="lidar_turret">
        <origin xyz="0 0 0.028" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.038" length="0.022"/>
        </geometry>
        <material name="amr_dark_grey"/>
      </visual>

      <!-- 3. Optical Sensor Window Aperture -->
      <visual name="lidar_optical_window">
        <origin xyz="0 0 0.028" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.041" length="0.010"/>
        </geometry>
        <material name="amr_sensor_lens"/>
      </visual>

      <!-- Exact collision geometry preserved from M1/M2 -->
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="0.04"/>
        </geometry>
      </collision>

      <!-- Exact inertial parameters preserved from M1/M2 -->
      <inertial>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia
          ixx="0.0001" ixy="0.0" ixz="0.0"
          iyy="0.0001" iyz="0.0"
          izz="0.0001"/>
      </inertial>
    </link>

  </xacro:macro>

</robot>
