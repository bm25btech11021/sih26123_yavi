<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Classic Palette (Preserved for compatibility) -->
  <material name="amr_orange">
    <color rgba="0.95 0.45 0.1 1.0"/>
  </material>

  <material name="amr_dark_grey">
    <color rgba="0.2 0.2 0.25 1.0"/>
  </material>

  <material name="amr_light_grey">
    <color rgba="0.7 0.7 0.75 1.0"/>
  </material>

  <material name="amr_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="amr_blue">
    <color rgba="0.1 0.5 0.9 1.0"/>
  </material>

  <!-- M2.5 Polished Industrial Palette -->
  <material name="amr_chassis_dark">
    <color rgba="0.12 0.14 0.16 1.0"/>
  </material>

  <material name="amr_safety_orange">
    <color rgba="0.90 0.36 0.00 1.0"/>
  </material>

  <material name="amr_rim_silver">
    <color rgba="0.65 0.69 0.72 1.0"/>
  </material>

  <material name="amr_rubber_black">
    <color rgba="0.08 0.09 0.10 1.0"/>
  </material>

  <material name="amr_sensor_lens">
    <color rgba="0.10 0.12 0.17 1.0"/>
  </material>

  <material name="amr_status_green">
    <color rgba="0.00 0.90 0.46 1.0"/>
  </material>

  <material name="amr_status_amber">
    <color rgba="1.00 0.60 0.00 1.0"/>
  </material>

  <material name="amr_badge_panel">
    <color rgba="0.05 0.07 0.09 1.0"/>
  </material>

  <material name="amr_accent_cyan">
    <color rgba="0.00 0.74 0.83 1.0"/>
  </material>

  <material name="amr_white_text">
    <color rgba="0.96 0.96 0.98 1.0"/>
  </material>

</robot>
