Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Status1
    - /TF1
    - /Warehouse_Environment1
    Splitter Ratio: 0.5
  Tree Height: 600
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1.0
    Class: rviz_default_plugins/Grid
    Color: 140; 140; 150
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 16.0
      Y: 16.0
      Z: 0.0
    Plane: XY
    Plane Cell Count: 32
    Reference Frame: map
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 0.4
    Name: TF
    Show Arrows: false
    Show Axes: true
    Show Names: false
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Warehouse_Environment
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /warehouse_markers
    Value: true
  - Alpha: 1.0
    Class: rviz_default_plugins/RobotModel
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /amr_0/robot_description
    Enabled: true
    Name: RobotModel_amr_0
    Visual Enabled: true
  - Alpha: 1.0
    Autocompute Intensity Bounds: false
    Class: rviz_default_plugins/LaserScan
    Color: 255; 80; 0
    Color Transformer: FlatColor
    Decay Time: 0.0
    Enabled: true
    Name: LaserScan_amr_0
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.06
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /amr_0/scan
    Use Fixed Frame: true
    Use rainbow: false
    Value: true
  - Alpha: 1.0
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 255; 80; 0
    Enabled: true
    Head Diameter: 0.2
    Head Length: 0.2
    Length: 0.3
    Line Style: Lines
    Line Width: 0.05
    Name: Path_amr_0
    Offset:
      X: 0.0
      Y: 0.0
      Z: 0.05
    Pose Color: 255; 80; 0
    Pose Style: None
    Radius: 0.03
