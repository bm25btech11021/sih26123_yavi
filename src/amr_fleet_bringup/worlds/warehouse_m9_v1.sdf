    <!-- Warehouse Floor Markings: Lanes & Cross-Aisles -->
    <model name="warehouse_lanes">
      <static>true</static>
      <pose>0 0 0.002 0 0 0</pose>
      <link name="markings_link">
        <!-- North-South Aisle Lines -->
        <visual name="lane_aisle_1"><pose>2.5 16.0 0 0 0 0</pose><geometry><box><size>0.10 28.0 0.001</size></box></geometry><material><ambient>0.88 0.72 0.08 1.0</ambient><diffuse>0.92 0.78 0.10 1.0</diffuse></material></visual>
