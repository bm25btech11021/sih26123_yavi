<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="warehouse_m9_v1">

    <!-- Physics Configuration (DART Engine Preserved from M1-M8) -->
    <physics name="default_physics" type="dart">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential System Plugins for Gazebo Harmonic -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Viewport / Demonstration Camera for 32m x 32m Warehouse -->
    <gui fullscreen="false">
      <plugin name="3D View" filename="GzScene3D">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.55 0.57 0.60 1.0</ambient_light>
        <background_color>0.82 0.86 0.90 1.0</background_color>
        <camera_pose>16.0 -6.0 32.0 0 0.95 1.5708</camera_pose>
      </plugin>
      <plugin name="World control" filename="WorldControl">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>0</start_paused>
      </plugin>
      <plugin name="World stats" filename="WorldStats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>
    </gui>

    <!-- Scene Lighting & Visual Atmosphere -->
    <scene>
      <ambient>0.52 0.54 0.58 1.0</ambient>
      <background>0.82 0.86 0.90 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Primary Warehouse Overhead Illumination -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>16.0 16.0 25.0 0 0 0</pose>
      <diffuse>0.88 0.88 0.90 1.0</diffuse>
      <specular>0.25 0.25 0.25 1.0</specular>
      <direction>-0.3 0.2 -0.92</direction>
    </light>

    <!-- Auxiliary Fill Light for Uniform Facility Visibility -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>16.0 16.0 20.0 0 0 0</pose>
      <diffuse>0.35 0.36 0.40 1.0</diffuse>
      <direction>0.3 -0.2 -0.92</direction>
    </light>

    <!-- Warehouse Floor (Industrial Slate-Grey Epoxy Finish) -->
    <model name="ground_plane">
      <static>true</static>
      <pose>16.0 16.0 0.0 0 0 0</pose>
      <link name="floor_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.24 0.27 1.0</ambient>
            <diffuse>0.26 0.28 0.32 1.0</diffuse>
            <specular>0.45 0.45 0.50 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Boundary Perimeter Walls (32m x 32m interior centered at 16.0, 16.0) -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>16.0 32.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>32.4 0.4 2.0</size></box></geometry></collision>
        <visual name="wall_vis">
          <geometry><box><size>32.4 0.4 2.0</size></box></geometry>
          <material><ambient>0.40 0.44 0.50 1.0</ambient><diffuse>0.45 0.50 0.56 1.0</diffuse></material>
        </visual>
        <visual name="kickplate">
          <pose>0.0 -0.201 -0.85 0 0 0</pose>
          <geometry><box><size>32.38 0.02 0.30</size></box></geometry>
          <material><ambient>0.85 0.70 0.10 1.0</ambient><diffuse>0.90 0.75 0.10 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>16.0 0.0 1.0 0 0 0</pose>
