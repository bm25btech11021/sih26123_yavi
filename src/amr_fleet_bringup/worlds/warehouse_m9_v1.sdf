        <visual name="cross_mid_south"><pose>16.0 8.5 0 0 0 0</pose><geometry><box><size>28.0 0.10 0.001</size></box></geometry><material><ambient>0.88 0.72 0.08 1.0</ambient><diffuse>0.92 0.78 0.10 1.0</diffuse></material></visual>
