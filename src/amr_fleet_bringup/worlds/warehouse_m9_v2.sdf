    <model name="wall_east">
      <static>true</static>
      <pose>32.0 16.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 32.4 2.0</size></box></geometry></collision>
        <visual name="wall_vis">
          <geometry><box><size>0.4 32.4 2.0</size></box></geometry>
          <material><ambient>0.40 0.44 0.50 1.0</ambient><diffuse>0.45 0.50 0.56 1.0</diffuse></material>
        </visual>
        <visual name="kickplate">
          <pose>-0.201 0.0 -0.85 0 0 0</pose>
          <geometry><box><size>0.02 32.38 0.30</size></box></geometry>
          <material><ambient>0.85 0.70 0.10 1.0</ambient><diffuse>0.90 0.75 0.10 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>0.0 16.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 32.4 2.0</size></box></geometry></collision>
        <visual name="wall_vis">
          <geometry><box><size>0.4 32.4 2.0</size></box></geometry>
